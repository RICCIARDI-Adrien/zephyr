config PWM_RCAR5
	bool "Renesas R-Car Gen5 PWM driver"
	default y
	depends on DT_HAS_RENESAS_PWM_RCAR5_ENABLED
	select PINCTRL
	help
	  Enable the PWM driver for Renesas R-Car Gen5 SoCs.
