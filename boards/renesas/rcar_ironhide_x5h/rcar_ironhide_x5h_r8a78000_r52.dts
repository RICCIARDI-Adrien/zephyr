&rswitch_tsn0 {
	phy-handle = <&rswitch_phy0>;
	status = "disabled";
};

&rswitch_tsn4 {
	local-mac-address = [FA DA CA CA BA 04];
	phy-handle = <&rswitch_phy4>;
	phy-connection-type = "gmii";
	status = "okay";
};

&rswitch_tsn5 {
	local-mac-address = [FA DA CA CA BA 05];
	phy-handle = <&rswitch_phy5>;
	//status = "okay";
	status = "disabled";
};

&rswitch_mdio0 {
	status = "disabled";

	// TEST
	rswitch_phy0: ethernet-phy@9 {
		compatible = "ethernet-phy";
		reg = <9>;
		default-speeds = "10BASE Half-Duplex";
		status = "disabled";
	};
};

&rswitch_mdio4 {
	pinctrl-0 = <&rswitch_etha4_phyint_default
		     &rswitch_etha4_link_default
		     &rswitch_etha4_mdc_default
		     &rswitch_etha4_mdio_default>;
	pinctrl-names = "default";
	status = "okay";

	rswitch_phy4: ethernet-phy@2 {
		compatible = "ti,dp83867";
		reg = <2>;
		ti,interface-type = "gmii";
		default-speeds = "1000BASE Full-Duplex";
		status = "okay";
	};
};

&rswitch_mdio5 {
	// TODO TEST
	pinctrl-0 = <&rswitch_etha4_phyint_default
		     &rswitch_etha4_link_default
		     &rswitch_etha4_mdc_default
		     &rswitch_etha4_mdio_default>;
	pinctrl-names = "default";
	//status = "okay";
	status = "disabled";

	// TODO test avec 3 pour ne pas écrire sur le vrai PHY
	//ethernet-phy@2 {
	rswitch_phy5: ethernet-phy@3 {
		compatible = "ethernet-phy"; // TEST
		//reg = <2>;
		reg = <3>;
		default-speeds = "1000BASE Full-Duplex";
		//status = "okay";
		status = "disabled";
	};
};
